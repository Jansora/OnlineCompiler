DATABASE_URL=postgresql://user:password@localhost:5432/online_compiler
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-to-a-long-unique-password
# Session lifetime in days; default 365.
# SESSION_MAX_AGE_DAYS=365
# Optional: caches the recent code list for five seconds. PostgreSQL remains the source of truth.
# REDIS_URL=redis://localhost:6379/3
RUN_TIMEOUT_MS=15000
RUN_MAX_OUTPUT_BYTES=65536
# Optional for a privileged host setup; Dockerfile runs code as UID/GID 10001.
# RUNNER_UID=10001
# RUNNER_GID=10001
